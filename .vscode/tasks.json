{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "H-WAP: setup environment",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/setup_env.sh"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "H-WAP: check environment",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/check_env.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "H-WAP: simulation tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "pytest", "tests", "-q"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "H-WAP: direct and oracle pilot",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/run_experiment.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
